# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (friend's shared Postgres)
# Shared 20-connection cap, so keep the pool small
DATABASE_URL="postgresql://friend:<password>@9u25c268.free.tryportwarp.cc:10020/friend?sslmode=require&User=<yourUsername>&Password=<yourPassword>"

# CORS Configuration
CLIENT_ORIGIN="http://localhost:3000"

# Receipt Signing Secret
RECEIPT_SIGNING_KEY="your-receipt-signing-secret"

# Daily Reconciliation & Volume Anomaly Detection (Story ID 04)
# Price charged per litre (KES) used to compute Expected Revenue = Volume × Price.
# Defaults to 2 (Sprint 2 §3.1 maps 500 L -> 1000 KES).
WATER_UNIT_PRICE_PER_LITER=2
# Number of prior daily records used as the moving-average baseline (7 or 30).
# A volume is flagged as an anomaly when |volume - movingAvg| > 30% of movingAvg.
ANOMALY_BASELINE_WINDOW=7
# Run the reconciliation batch in-process once a day at 00:15 UTC (default off;
# production can also trigger it with POST /api/kiosk/reconciliation/run).
RECONCILIATION_BATCH_ENABLED=false


# Google Sheets Sync (Story 03) – leave all empty to disable
# Approved logs (isReadByManager=true) sync once per minute. Failed 429/network
# attempts are retried with exponential backoff; permanent failures are audited.
# 1. Create a Service Account in Google Cloud, enable "Google Sheets API",
#    and download a JSON key.
# 2. Share the spreadsheet with the service account's client_email (Editor).
# Spreadsheet ID = the part between /d/ and /edit in the sheet URL.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="Sheet1"
GOOGLE_SHEETS_TIMEZONE="Asia/Bangkok"
GOOGLE_SHEETS_TIMEOUT_MS=15000
# Credentials – set ONE of the options below:
# a) Whole JSON key (raw JSON on one line, or base64 of the file)
GOOGLE_SERVICE_ACCOUNT_JSON=""
# b) Email + private key from the JSON key (keep the \n escapes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
# c) Path to the JSON key file (keep it out of git)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""

# Evidence photo hosting (imgBB) – create a key at https://api.imgbb.com/
# Reading photos are uploaded to imgBB and only the returned URL is stored on
# DailyLog.proofImageUrl; leave empty to disable photo uploads (the operator
# client keeps entries queued instead).
IMGBB_API_KEY=""
# Optional: how long the server waits for an imgBB upload before answering 503
# (milliseconds). Multi-megabyte phone photos need a generous budget.
IMGBB_TIMEOUT_MS=90000
