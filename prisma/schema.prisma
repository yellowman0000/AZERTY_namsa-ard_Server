generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Story 01: Store Kiosk status and Heartbeat
model Kiosk {
  id            String     @id                                  // "KIOSK-001"
  status        String     @default("OFFLINE")                  // "ONLINE" or "OFFLINE"
  lastHeartbeat DateTime?  @map("last_heartbeat")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  
  logs          DailyLog[]

  @@map("kiosks")
}

// Story 02, 14-2, 14-3: Store DailyLog and meter volume
model DailyLog {
  id            String   @id @default(uuid())
  transactionId String   @unique @map("transaction_id")           // for Ball to check Idempotency (prevent duplicate sending)
  kioskId       String   @map("kiosk_id")
  kiosk         Kiosk    @relation(fields: [kioskId], references: [id])
  
  meterVolume   Float    @map("meter_volume")
  checksum      String?                                           // for Story 14-2: store Hash to check data corruption
  isSynced      Boolean  @default(true) @map("is_synced")         // for Story 14-3
  
  recordedAt    DateTime @map("recorded_at")                      // recorded time from Kiosk
  createdAt     DateTime @default(now()) @map("created_at")       // time when server received

  @@map("daily_logs")
}